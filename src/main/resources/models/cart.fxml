<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.CartController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleBack" text="← Back" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Shopping Cart &amp; Checkout" />
            </children>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </padding>
            <children>
                <!-- Left Side: Available Parts Table -->
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Available Parts" />
                        <TableView fx:id="partsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" />
                                <TableColumn fx:id="colName" prefWidth="200.0" text="Name" />
                                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Price" />
                                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Quantity:" />
                                <TextField fx:id="txtQuantity" promptText="Qty" prefWidth="80.0" />
                                <Button mnemonicParsing="false" onAction="#handleAddToCart" style="-fx-base: #2196F3;" text="Add to Cart" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Right Side: Cart Table & Order Summary -->
                <VBox spacing="10.0" prefWidth="450.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Your Cart" />
                        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCartName" prefWidth="200.0" text="Item Name" />
                                <TableColumn fx:id="colCartQty" prefWidth="80.0" text="Qty" />
                                <TableColumn fx:id="colCartPrice" prefWidth="120.0" text="Total Price" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleRemove" style="-fx-base: #f44336;" text="Remove" />
                                <Button mnemonicParsing="false" onAction="#handleClearCart" text="Clear Cart" />
                            </children>
                        </HBox>
                        <VBox spacing="5.0" style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-background-radius: 5;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Subtotal:" />
                                        <HBox HBox.hgrow="ALWAYS" />
                                        <Label fx:id="subtotalLabel" text="Rs. 0.00" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Discount:" />
                                        <HBox HBox.hgrow="ALWAYS" />
                                        <Label fx:id="discountLabel" text="Rs. 0.00" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="Total:" />
                                        <HBox HBox.hgrow="ALWAYS" />
                                        <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Rs. 0.00" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCheckout" style="-fx-base: #4CAF50; -fx-font-size: 14px; -fx-font-weight: bold;" text="Checkout" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>