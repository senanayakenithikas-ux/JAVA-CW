<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.InventoryController">
    <children>

        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnBack" onAction="#handleBack" text="← Back" />
                        <Label text="Inventory Management">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>


                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>

                        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" prefWidth="900.0">
                            <columns>
                                <TableColumn fx:id="colCode" prefWidth="80" text="Part Code" />
                                <TableColumn fx:id="colName" prefWidth="110.0" text="Name" />
                                <TableColumn fx:id="colBrand" prefWidth="92.0" text="Brand" />
                                <TableColumn fx:id="colPrice" prefWidth="86.0" text="Price" />
                                <TableColumn fx:id="colQty" prefWidth="82.0" text="Quantity" />
                                <TableColumn fx:id="colCategory" prefWidth="89.0" text="Category" />
                                <TableColumn fx:id="colDate" prefWidth="71.0" text="Date Added" />
                                <TableColumn fx:id="colThreshold" prefWidth="140.0" text="Threshold" />
                            </columns>
                        </TableView>


                        <VBox alignment="TOP_CENTER" maxWidth="220.0" minWidth="200.0"  prefHeight="460.0" prefWidth="220.0" spacing="10.0">
                            <children>
                                <ImageView fx:id="partImage" fitHeight="150.0" fitWidth="150.0" preserveRatio="true" />                                <Label text="Total Parts:">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <Label fx:id="totalCountLabel" text="0" />
                                <Label text="Total Value:">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <Label fx:id="totalValueLabel" text="0.00" />
                            </children>
                        </VBox>
                    </children>
                </HBox>


                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="txtPartCode" promptText="Part Code" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtName" promptText="Name" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtBrand" promptText="Brand" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtPrice" promptText="Price" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtQuantity" promptText="Quantity" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtCategory" promptText="Category" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtThreshold" promptText="Threshold" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtDate" promptText="Date (dd-MM-yyyy)" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtImage" promptText="Image filename" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBrowse" text="Browse" onAction="#handleBrowseImage" />
                    </children>
                </HBox>

                
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#handleAdd" text="Add Part" />
                        <Button onAction="#handleUpdate" text="Update Part" />
                        <Button onAction="#handleDelete" text="Delete Part" />
                        <Button onAction="#handleClear" text="Clear" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
