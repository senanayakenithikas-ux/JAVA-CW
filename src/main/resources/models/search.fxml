<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Font?>
<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.SearchController">
    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" text="← Back" />
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Search Inventory" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Keyword:" />
                                <TextField fx:id="txtKeyword" promptText="Name or Brand..." prefWidth="200.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Category:" />
                                <ComboBox fx:id="categoryCombo" prefWidth="150.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Min Price:" />
                                <TextField fx:id="txtMinPrice" promptText="0.00" prefWidth="100.0" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Max Price:" />
                                <TextField fx:id="txtMaxPrice" promptText="Max" prefWidth="100.0" />
                            </children>
                        </VBox>

                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                            <padding>
                                <Insets bottom="2.0" />
                            </padding>
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-base: #2196F3;" text="Search" />
                                <Button mnemonicParsing="false" onAction="#handleClear" text="Clear" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="searchTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="120.0" text="Part Code" />
                <TableColumn fx:id="colName" prefWidth="250.0" text="Part Name" />
                <TableColumn fx:id="colBrand" prefWidth="150.0" text="Brand" />
                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Price" />
                <TableColumn fx:id="colQty" prefWidth="100.0" text="Quantity" />
                <TableColumn fx:id="colCategory" prefWidth="180.0" text="Category" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>