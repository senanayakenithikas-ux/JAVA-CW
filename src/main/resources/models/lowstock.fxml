<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.LowStockController">
    <top>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleBack" text="← Back" />
                        <Label text="Low Stock Threshold:" />
                        <TextField fx:id="txtThreshold" promptText="Enter threshold" prefWidth="100" />
                        <Button mnemonicParsing="false" onAction="#handleUpdateThreshold" text="Update Threshold" />
                        <Label text="Items below threshold:" />
                        <Label fx:id="lowStockCountLabel" text="0" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleRefresh" style="-fx-base: #2196F3;" text="Refresh" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="lowStockTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCode" prefWidth="150.0" text="Part Code" />
                <TableColumn fx:id="colName" prefWidth="350.0" text="Part Name" />
                <TableColumn fx:id="colQty" prefWidth="150.0" text="Quantity" />
                <TableColumn fx:id="colThreshold" prefWidth="150.0" text="Threshold" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="20.0" left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>